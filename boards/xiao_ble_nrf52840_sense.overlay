/*
 * Custom Devicetree Overlay for Seeed Studio XIAO nRF52840 Sense
 *
 * This file is automatically picked up by the Zephyr build system
 * based on its filename: <board_identifier>.overlay
 *
 * PWM is used here so all three RGB LEDs can be dimmed independently.
 * PWM0 channels 0-2 are mapped to the same GPIO pins as the board's
 * built-in led0/led1/led2 (P0.26 red, P0.30 green, P0.06 blue).
 */

/* Disable the plain GPIO leds node to avoid pin conflicts with PWM. */
&led0 { status = "disabled"; };
&led1 { status = "disabled"; };
&led2 { status = "disabled"; };

/* Configure PWM0 pin-control states for the three LED pins. */
&pinctrl {
    pwm0_default: pwm0_default {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 26)>,   /* Red   – P0.26 */
                    <NRF_PSEL(PWM_OUT1, 0, 30)>,   /* Green – P0.30 */
                    <NRF_PSEL(PWM_OUT2, 0, 6)>;    /* Blue  – P0.06 */
            nordic,invert; /* LEDs are active-low */
        };
    };

    pwm0_sleep: pwm0_sleep {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 26)>,
                    <NRF_PSEL(PWM_OUT1, 0, 30)>,
                    <NRF_PSEL(PWM_OUT2, 0, 6)>;
            low-power-enable;
        };
    };
};

/* Enable PWM0 with the pinctrl states defined above. */
&pwm0 {
    status = "okay";
    pinctrl-0 = <&pwm0_default>;
    pinctrl-1 = <&pwm0_sleep>;
    pinctrl-names = "default", "sleep";
};

/ {
    /* PWM LED nodes – one per colour channel. */
    pwmleds {
        compatible = "pwm-leds";

        pwm_led0: pwm_led_0 {
            pwms = <&pwm0 0 PWM_MSEC(20) PWM_POLARITY_INVERTED>;
            label = "Red LED";
        };

        pwm_led1: pwm_led_1 {
            pwms = <&pwm0 1 PWM_MSEC(20) PWM_POLARITY_INVERTED>;
            label = "Green LED";
        };

        pwm_led2: pwm_led_2 {
            pwms = <&pwm0 2 PWM_MSEC(20) PWM_POLARITY_INVERTED>;
            label = "Blue LED";
        };
    };

    aliases {
        pwm-led0    = &pwm_led0;
        pwm-led1    = &pwm_led1;
        pwm-led2    = &pwm_led2;
        /* No physical buzzer on XIAO; map to blue LED (P0.06) for visual feedback */
        buzzer-pwm  = &pwm_led2;
        /* The user button on the XIAO board (P0.18, active-low) */
        user-button = &user_button;
        /* Reuse P0.26 (red LED GPIO) as software status LED */
        status-led  = &status_led_xiao;
    };
    /* XIAO user button: P0.18, active-low, pull-up. */
    buttons {
        compatible = "gpio-keys";
        user_button: button_0 {
            gpios = <&gpio0 18 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
            label = "User Button";
        };
    };

    /* Status LED — plain GPIO on P0.26 (same physical pin as red PWM LED).
     * Used for software blink patterns.  The PWM red channel is still
     * available via pwm_led0 when buzzer feedback is needed. */
    leds {
        compatible = "gpio-leds";
        status_led_xiao: led_status {
            gpios = <&gpio0 26 GPIO_ACTIVE_LOW>;
            label = "Status LED";
        };
    };
};

&timer3 {
    status = "okay";
};

/* Enable the NFCT peripheral so HAS_HW_NRF_NFCT is set and NFC_PLATFORM
 * can compile the platform glue (nfc_platform_* symbols). */
&nfct {
    status = "okay";
};
