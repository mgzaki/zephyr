/*
 * HaykulTracker Devicetree Overlay
 * Targeting Raytac MDBT50Q-P1MV2 (nRF52840)
 *
 * Verified pin mapping from tracker.kicad_sch:
 *   BMA400 (I2C mode):
 *     SCL -> P0.12,  SDA -> P0.11,  INT1 -> P0.13
 *     CSB -> VDD (I2C enabled), SDO -> GND (I2C addr 0x14)
 *   Buzzer:
 *     P0.14 -> BSS138 Gate -> MOSFET drives piezo buzzer
 *   NFC:
 *     P0.09/P0.10 (nRF52840 built-in NFC pins)
 */

/ {
    aliases {
        buzzer-pwm  = &buzzer_pwm;
        user-button = &user_button;
        status-led  = &status_led_0;
    };

    buzzer {
        compatible = "pwm-leds";
        buzzer_pwm: buzzer_0 {
            pwms = <&pwm0 0 PWM_HZ(4000) PWM_POLARITY_NORMAL>;
            label = "Piezo Buzzer";
        };
    };

    /* Push-button SW1: connected between P1.10 and GND (active-low). */
    buttons {
        compatible = "gpio-keys";
        user_button: button_0 {
            gpios = <&gpio1 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
            label = "User Button";
        };
    };

    /* Software status LED on P0.20. Active-high.
     * Note: D1 (charging LED) is driven by MCP73831 STAT — not by firmware. */
    leds {
        compatible = "gpio-leds";
        status_led_0: led_0 {
            gpios = <&gpio0 20 GPIO_ACTIVE_HIGH>;
            label = "Status LED";
        };
    };
};

&pinctrl {
    i2c0_default: i2c0_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SCL, 0, 12)>,  /* P0.12 -> BMA400 SCX */
                    <NRF_PSEL(TWIM_SDA, 0, 11)>;   /* P0.11 -> BMA400 SDX */
        };
    };

    i2c0_sleep: i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SCL, 0, 12)>,
                    <NRF_PSEL(TWIM_SDA, 0, 11)>;
            low-power-enable;
        };
    };

    pwm0_default: pwm0_default {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 14)>;   /* P0.14 -> BSS138 Gate -> Buzzer */
        };
    };

    pwm0_sleep: pwm0_sleep {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 14)>;
            low-power-enable;
        };
    };
};

&i2c0 {
    compatible = "nordic,nrf-twim";
    status = "okay";
    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
    pinctrl-names = "default", "sleep";
    clock-frequency = <I2C_BITRATE_FAST>;  /* 400kHz */
};

&pwm0 {
    status = "okay";
    pinctrl-0 = <&pwm0_default>;
    pinctrl-1 = <&pwm0_sleep>;
    pinctrl-names = "default", "sleep";
};

/* Enable SAADC for internal VDDHDIV5 battery-level measurement. */
&adc {
    status = "okay";
};
